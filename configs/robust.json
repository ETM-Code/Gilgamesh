{
  "mode": "simple",
  "network": {
    "input_size": 49,
    "hidden_size": 100,
    "output_size": 10
  },
  "neuron": {
    "beta": 0.9,
    "threshold": 1.0,
    "reset_mechanism": "subtract",
    "slope": 25.0
  },
  "training": {
    "lr": 0.001,
    "epochs": 15,
    "batch_size": 128,
    "num_steps": 25,
    "seed": 42
  },
  "quantization": {
    "enabled": true,
    "bits": 8,
    "apply_during_training": true,
    "symmetric": true
  },
  "noise": {
    "enabled": true,
    "training_only": true,
    "weight_std": 0.05,
    "threshold_std": 0.02,
    "membrane_std": 0.01,
    "input_std": 0.1
  },
  "output": {
    "mode": "spike_count"
  }
}
