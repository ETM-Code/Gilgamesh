{
  "_comment": "Hardware-matched config for the Tarski InputSystem PCB.",
  "_comment2": "Use this for training networks to deploy on the physical board.",
  "_comment3": "All values from the final KiCad schematic + emulator calibration.",

  "mode": "physics",
  "network": {
    "input_size": 36,
    "hidden_size": 9,
    "output_size": 10,
    "image_size": 6
  },
  "neuron": {
    "threshold": 1.0,
    "slope": 25.0
  },
