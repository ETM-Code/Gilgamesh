  "noise": {
    "enabled": true,
    "weight_std": 0.05,
    "threshold_std": 0.02,
    "membrane_std": 0.01,
    "input_std": 0.1
  },
  "training": {
    "lr": 0.001,
    "epochs": 15,
    "batch_size": 128,
    "num_steps": 25,
    "seed": 42
  }
