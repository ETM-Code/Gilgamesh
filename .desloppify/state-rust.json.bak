      "tier": 1,
      "confidence": "high",
      "summary": "ArchitectureInfo.mode uses String instead of existing OperationMode enum",
      "detail": {
        "holistic": true,
        "dimension": "type_safety",
        "related_files": [
          "src/checkpoint.rs",
          "src/config.rs"
        ],
        "evidence": [
          "checkpoint.rs line 54: pub mode: String. config.rs defines OperationMode enum with Simple/Physics variants and proper serde support. Checkpoint consumers must string-compare rather than pattern-match on the typed enum."
