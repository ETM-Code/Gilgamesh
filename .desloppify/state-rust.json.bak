    "review::.::holistic::initialization_coupling::rayon_global_in_constructor": {
      "id": "review::.::holistic::initialization_coupling::rayon_global_in_constructor",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "rayon::build_global() called as side effect inside Trainer::new() silently locks thread pool config",
      "detail": {
        "holistic": true,
        "dimension": "initialization_coupling",
        "related_files": [
          "src/training.rs"
        ],
        "evidence": [
          "src/training.rs:319-322 calls rayon::ThreadPoolBuilder::new().num_threads(config.num_workers).build_global().ok() \u2014 the .ok() silently discards the error if the pool was already initialized, meaning the second Trainer's num_workers is silently ignored"
        ],
        "suggestion": "Move rayon pool initialization to the CLI entry point (e.g., train command handler) where it is a one-time setup, or document that num_workers only takes effect on the first Trainer construction",
