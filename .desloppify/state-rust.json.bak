    "review::.::holistic::contract_coherence::network_new_beta_misleading": {
      "id": "review::.::holistic::contract_coherence::network_new_beta_misleading",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "Network::new() takes beta param but defaults to Physics mode where beta is derived, not primary",
      "detail": {
        "holistic": true,
        "dimension": "contract_coherence",
        "related_files": [
          "src/network/network.rs",
          "src/neurons/lif/builder.rs"
        ],
        "evidence": [
          "Network::new() signature is new(input_size, hidden_size, output_size, beta, seed) and doc says 'defaults to Physics mode'. But beta is a simple-mode concept; in Physics mode it's derived from tau_m/dt. Leaky::new(size, beta) internally defaults to Physics mode and computes beta from default tau_m/dt, potentially ignoring the passed beta value."
        ],
        "suggestion": "Either make Network::new() create simple-mode networks (matching the beta parameter's semantic meaning) and require explicit Network::new_physics() for physics mode, or remove the beta parameter from new() and derive it from NeuronMode defaults.",
        "reasoning": "",
        "summary_hash": "af7aa765"
      },
      "status": "wontfix",
      "note": "Low confusion risk; Network::new() mostly used in tests; Physics default is intentional",
